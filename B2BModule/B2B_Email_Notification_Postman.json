{
  "info": {
    "_postman_id": "b2b-email-notification",
    "name": "B2B Email Notification System",
    "description": "Collection pour tester les endpoints de notification email",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Email Notifications",
      "item": [
        {
          "name": "1. Send ACCEPTED Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"candidateEmail\": \"aziz2guizeni@gmail.com\",\"candidateName\": \"Jean Dupont\",\"jobTitle\": \"Senior Backend Developer\",\"companyName\": \"TechCorp International\",\"status\": \"ACCEPTED\",\"message\": \"Nous sommes ravis de vous accueillir dans notre équipe! Votre profil nous a beaucoup impressionnés.\"}"
            },
            "url": {
              "raw": "http://localhost:8083/api/b2b/applications/notify",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8083",
              "path": [
                "api",
                "b2b",
                "applications",
                "notify"
              ]
            },
            "description": "Envoie un email d'acceptation au candidat"
          },
          "response": []
        },
        {
          "name": "2. Send REJECTED Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"candidateEmail\": \"aziz2guizeni@gmail.com\",\"candidateName\": \"Jean Dupont\",\"jobTitle\": \"Data Scientist\",\"companyName\": \"DataFlow Solutions\",\"status\": \"REJECTED\",\"message\": \"Merci pour votre candidature. Nous vous encourageons à postuler pour les futures opportunités.\"}"
            },
            "url": {
              "raw": "http://localhost:8083/api/b2b/applications/notify",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8083",
