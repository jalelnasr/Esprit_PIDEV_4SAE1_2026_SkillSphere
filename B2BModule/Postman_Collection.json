{
  "info": {
    "name": "B2B Module - Email Notification API",
    "description": "Postman collection for testing email notification endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Send Notification - ACCEPTED with Message",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"candidateEmail\": \"john.doe@example.com\",\n  \"candidateName\": \"John Doe\",\n  \"jobTitle\": \"Data Analyst\",\n  \"companyName\": \"TechCorp Inc.\",\n  \"status\": \"ACCEPTED\",\n  \"message\": \"Congratulations! We are excited to have you join our data science team. Your onboarding will begin next week.\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/b2b/applications/notify",
          "host": ["{{base_url}}"],
          "path": ["api", "b2b", "applications", "notify"]
        }
      }
    },
    {
