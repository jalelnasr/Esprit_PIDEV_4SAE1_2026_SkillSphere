        posts p1_0 
            on p1_0.post_id=pl1_0.post_id 
    where
        p1_0.user_id=? 
        and pl1_0.user_id<>? 
        and pl1_0.created_at>? 
    order by
        pl1_0.created_at desc 
    limit
        ?, ?
